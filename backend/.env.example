DJANGO_SECRET_KEY=change-me-in-production
# Local: True. Production: omit or set False (code default is False).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=CargoDZ
DB_USER=Taki_CargoDZ
DB_PASSWORD=taki
DB_HOST=localhost
DB_PORT=5432

# Include every frontend origin that calls the API (comma-separated).
# Local Vite + Netlify production (and custom domain if any):
CORS_ALLOWED_ORIGINS=http://localhost:3025,http://127.0.0.1:3025
# Production example:
# CORS_ALLOWED_ORIGINS=https://your-site.netlify.app,https://www.yourdomain.com
# DJANGO_ALLOWED_HOSTS=your-api-host.example.com

JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

DRF_ANON_THROTTLE_RATE=60/min
DRF_USER_THROTTLE_RATE=600/min
DRF_LOGIN_THROTTLE_RATE=10/min
DRF_REFRESH_THROTTLE_RATE=30/min

# Destructive org wipe from Settings (keep False in production).
ALLOW_DATA_RESET=False

# Bootstrap payload cap per collection (goods, POs, payments, …).
BOOTSTRAP_MAX_PER_COLLECTION=2000

# Set to True behind HTTPS in production.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
